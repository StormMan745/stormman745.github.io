{
  "private": true,
  "scripts": {
    "build:app": "node build-app.cjs",
    "build:memories": "node build-memories.cjs",
    "build:qr": "node build-qr.cjs",
    "check:build": "node build-app.cjs --check",
    "test:auth": "node check-auth-controls.cjs",
    "test:push": "node check-push.cjs && node check-push-browser.cjs",
    "test:routine-times": "node check-offline-care.cjs --routine-times && node check-routine-day.cjs",
    "test:routine-push": "node check-push.cjs && node check-offline-care.cjs --routine-push && node --test ../mobile/tests/reminders.test.mjs",
    "test:assistant-records": "node check-assistant-records.cjs && node check-offline-care.cjs --assistant-records",
    "test:memories": "node check-offline-care.cjs --memories",
    "test:map-location": "node check-offline-care.cjs --map-location",
    "test:clinic-connections": "node check-clinic-edge.cjs && node check-care-edge.cjs && node check-offline-care.cjs --clinic-connections",
    "test:map-mobile": "node check-offline-care.cjs --map-mobile && node check-offline-care.cjs --map-mobile --iphone && node check-offline-care.cjs --map-location",
    "test:extras": "node check-offline-care.cjs --extras",
    "test:site-security": "node check-site-security.cjs && node check-browser-security.cjs",
    "build:pet-scene": "node build-pet-scene.cjs",
    "build:document-print": "node build-document-print.cjs",
    "test:security": "node security-edge-check.cjs",
    "test:care": "node check-care-edge.cjs && node check-auth-controls.cjs && node check-offline-care.cjs && node check-routine-day.cjs && node check-document-print.cjs",
    "build:document-ocr": "node build-document-ocr.cjs",
    "test:document-ocr": "node check-offline-care.cjs --document-ocr",
    "test:indefinite-courses": "node check-offline-care.cjs --indefinite-courses",
    "test:photo-library": "node check-offline-care.cjs --photo-library"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "mediabunny": "1.65.2",
    "pdfjs-dist": "6.5.438",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "6.0.1"
  }
}
